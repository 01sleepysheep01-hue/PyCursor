# Only key names belong in this example file. Never commit real values.
# DEEPSEEK_API_KEY also works as the key variable.
CODEPROOF_API_KEY=
CODEPROOF_BASE_URL=https://api.deepseek.com/v1
# Use deepseek-v4-flash only if your provider exposes this model and tool calls.
CODEPROOF_MODEL=deepseek-chat
CODEPROOF_WORKSPACE=./examples/workspace
CODEPROOF_MAX_STEPS=12
# Required for LAN/public H5 access. Use a random value with at least 12 characters.
CODEPROOF_WEB_TOKEN=

