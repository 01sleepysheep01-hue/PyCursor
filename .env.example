# Only key names belong in this example file. Never commit real values.
# DEEPSEEK_API_KEY also works as the key variable.
PYCURSOR_API_KEY=
PYCURSOR_BASE_URL=https://api.deepseek.com/v1
# Use deepseek-v4-flash only if your provider exposes this model and tool calls.
PYCURSOR_MODEL=deepseek-chat
PYCURSOR_WORKSPACE=./examples/workspace
PYCURSOR_MAX_STEPS=12

